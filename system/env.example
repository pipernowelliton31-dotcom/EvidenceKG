# Copy this file to system/.env (next to this file) and fill values locally.
# This template contains no credentials. Never commit system/.env.

# Built-in evaluation mode: enable it in the Web application's model settings.
# DeepSeek allows deepseek-flash only.
BUILTIN_DEEPSEEK_API_KEY=
# OpenRouter's default is nvidia/nemotron-3.5-super-vl:free.
BUILTIN_OPENROUTER_API_KEY=

# Optional custom connection defaults. Saved Web settings take precedence.
# Leave the key blank to configure a custom connection through the Web UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Leave blank if the provider does not support a reasoning parameter.
LLM_REASONING_EFFORT=
